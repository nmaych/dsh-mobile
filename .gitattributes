# Normalise line endings so a Windows checkout and a Linux CI run produce
# identical bytes — this matters for shell scripts, and for the Gradle wrapper
# JAR being treated as binary rather than mangled by EOL conversion.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.zip binary

# Keep generated files out of language statistics.
docs/rpc-methods.json linguist-generated=true
docs/rpc-methods.txt linguist-generated=true
docs/session-args.json linguist-generated=true
